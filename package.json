{
  "name": "scripture-cite",
  "version": "1.0.0",
  "description": "Zero-dependency web component for inline & tooltip scripture citations (Bible, Quran, Bhagavad Gita) with TypeScript enums and optional in-browser LLM Zen mode.",
  "homepage": "https://github.com/vinodlouis/scripture-cite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinodlouis/scripture-cite.git"
  },
  "bugs": {
    "url": "https://github.com/vinodlouis/scripture-cite/issues"
  },
  "type": "module",
  "sideEffects": true,
  "main": "./dist/scripture-cite.umd.cjs",
  "module": "./dist/scripture-cite.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/scripture-cite.js",
      "require": "./dist/scripture-cite.umd.cjs",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build && npm run build:types",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly --declaration --declarationMap --outDir dist/types",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run test && npm run build"
  },
  "keywords": [
    "scripture",
    "bible",
    "quran",
    "gita",
    "web-component",
    "citation",
    "typescript",
    "zero-dependency"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.0.0",
    "happy-dom": "^12.0.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.0",
    "vitest": "^1.0.0"
  }
}
